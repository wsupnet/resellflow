{
  "name": "resellflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "build:scripts": "esbuild prisma/seed.ts scripts/reset-password.ts --outbase=. --bundle --platform=node --format=cjs --outdir=dist --external:@prisma/client --external:.prisma --external:bcryptjs",
    "db:seed": "node dist/prisma/seed.js",
    "reset-password": "node dist/scripts/reset-password.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "adm-zip": "^0.5.18",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "jose": "5.9.6",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3",
    "sharp": "0.33.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "esbuild": "0.24.0",
    "postcss": "8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
