{
  "name": "resellflow",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "build:scripts": "esbuild prisma/seed.ts scripts/reset-password.ts scripts/ensure-secret.ts scripts/wait-for-db.ts scripts/db-url.ts --outbase=. --bundle --platform=node --format=cjs --outdir=dist --external:@prisma/client --external:.prisma --external:bcryptjs",
    "db:seed": "node dist/prisma/seed.js",
    "reset-password": "node dist/scripts/reset-password.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "adm-zip": "0.6.1",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "jose": "5.9.6",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "2.15.4",
    "sharp": "0.35.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.20",
    "esbuild": "0.28.2",
    "postcss": "8.5.32",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
