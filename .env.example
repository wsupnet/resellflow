# Optional. The app starts with no .env at all — every setting below has a
# default. Copy this to .env only to change something.

# --- Data folder ---
# The one folder that holds everything the app stores: database, photos, secrets.
# Default: ./data next to docker-compose.yml. On a NAS, e.g. /volume1/docker/appdata.
# Compose uses $DATA_DIR/reselling-app/{postgres,uploads,secrets,tailscale}.
# DATA_DIR=./data

# --- App ---
# Host port the app is published on.
# APP_PORT=3939
# Which network interface the port is published on. 127.0.0.1 (default) = only
# this computer can open the app. 0.0.0.0 = any device on your network can reach
# it by IP — needed for http://<NAS-IP>:3939 or a phone on the same Wi-Fi. (The
# Tailscale sidecar works either way.)
# APP_BIND=0.0.0.0

# --- Secrets (generated for you) ---
# Leave these unset: a random database password and session secret are created
# on first start and kept in $DATA_DIR/reselling-app/secrets/. Set them only if
# you want your own. The database keeps the password it was first created with,
# so don't change POSTGRES_PASSWORD after the first start.
# POSTGRES_PASSWORD=
# AUTH_SECRET=
# Only for an external database (or an older .env that already has it):
# DATABASE_URL=postgresql://user:password@host:5432/resellflow?schema=public
# POSTGRES_USER=resell
# POSTGRES_DB=resellflow

# --- First admin (optional) ---
# Normally you create the admin in the browser on first visit. Set these instead
# to create it at first start (12+ character password; example values refused).
# Only used while that account doesn't exist yet.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=

# --- Currency ---
# Each account uses its own manual USD/JPY rate unless it turns on "Fetch today's
# rate" in Settings; only then does the server call this free, no-key provider.
# Override to use another provider, or set it empty (FX_API_URL=) to block
# fetching for every account on this server.
# FX_API_URL=https://open.er-api.com/v6/latest/USD

# --- Reverse proxy (optional) ---
# Set TRUST_PROXY=1 only when every visitor reaches the app through a proxy you
# run (the Caddy or Tailscale profiles) AND APP_BIND is left at its default, so
# nobody can reach the app directly. Sign-in throttling then also counts failures
# per client IP (from X-Forwarded-For). Leave it unset otherwise: anyone reaching
# the app directly could fake that header.
# TRUST_PROXY=1

# --- HTTPS (optional, for phone camera scanning) ---
# Only used by the "https" Caddy profile. Set to your computer's LAN IP or a
# hostname, then run: docker compose --profile https up -d
# Note: Caddy publishes ports 80 and 443 on ALL network interfaces, regardless of
# APP_BIND — anyone on your network can reach the app through it.
# SITE_ADDRESS=localhost

# --- Tailscale (optional, "ts" profile) ---
# TS_AUTHKEY=tskey-auth-...
# TS_HOSTNAME=resellflow
# Set this so the tailscale sidecar starts with every `up`:
# COMPOSE_PROFILES=ts
