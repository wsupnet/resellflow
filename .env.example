# Copy to .env and fill in. Variables marked REQUIRED have no default —
# docker compose refuses to start until they're set.

# --- Database ---
POSTGRES_USER=resell
# REQUIRED
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=resellflow
# REQUIRED. Used by the app container to reach the db service; must contain the
# same user/password/db as the POSTGRES_* values above.
DATABASE_URL=postgresql://resell:change-me-strong@db:5432/resellflow?schema=public

# --- Auth ---
# Optional. Signs login sessions. Leave it unset and a random secret is generated
# on first boot and saved in $APPDATA/reselling-app/secrets/auth_secret. To set
# your own, use: openssl rand -base64 48  (placeholders / <32 chars are refused)
# AUTH_SECRET=

# --- First admin (created automatically on first boot) ---
# REQUIRED. This is the only account that can mint invite codes. Use your own
# password (12+ characters): the stack won't start while it's blank, and the
# first boot refuses old example passwords.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# --- App data (REQUIRED) ---
# Folder that holds the app's persistent data, outside the repo. Compose mounts
# $APPDATA/reselling-app/{postgres,uploads,secrets,tailscale} into the containers.
# Local dev: ./dev-data (git-ignored). On the NAS: APPDATA=/volume1/docker/appdata
APPDATA=./dev-data

# --- App ---
# Host port the app is published on.
APP_PORT=3939
# Which network interface the port is published on. 127.0.0.1 (default) = only
# this computer can open the app. 0.0.0.0 = any device on your network can reach
# it by IP — needed for http://<NAS-IP>:3939 or a phone on the same Wi-Fi. (The
# Tailscale sidecar works either way.)
# APP_BIND=0.0.0.0

# --- Currency ---
# Each account uses its own manual USD/JPY rate unless it turns on "Fetch today's
# rate" in Settings; only then does the server call this free, no-key provider.
# Override to use another provider, or set it empty (FX_API_URL=) to block
# fetching for every account on this server.
# FX_API_URL=https://open.er-api.com/v6/latest/USD

# --- Reverse proxy (optional) ---
# Set TRUST_PROXY=1 only when every visitor reaches the app through a proxy you
# run (the Caddy or Tailscale profiles) AND APP_BIND is left at its default, so
# nobody can reach the app directly. Sign-in throttling then also counts failures
# per client IP (from X-Forwarded-For). Leave it unset otherwise: anyone reaching
# the app directly could fake that header.
# TRUST_PROXY=1

# --- HTTPS (optional, for phone camera scanning) ---
# Only used by the "https" Caddy profile. Set to your Mac's LAN IP or a hostname.
# Then run: docker compose --profile https up -d   (then visit https://SITE_ADDRESS)
# Note: Caddy publishes ports 80 and 443 on ALL network interfaces, regardless of
# APP_BIND — anyone on your network can reach the app through it.
SITE_ADDRESS=localhost

# --- Tailscale (optional, "ts" profile) ---
# TS_AUTHKEY=tskey-auth-...
# TS_HOSTNAME=resellflow
# Set on the NAS so the tailscale sidecar starts with every `up`; leave unset on
# the Mac if you don't need it.
# COMPOSE_PROFILES=ts
